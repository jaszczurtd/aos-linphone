 unsigned long __bctbx_thread_self(void) {
+#ifdef __AROS__
+	/* AROS gives the initial task the pthread id 0, which the stack takes as "no thread". */
+	return (unsigned long)pthread_self() + 1;
+#else
 	return (unsigned long)pthread_self();
+#endif
 }
 
