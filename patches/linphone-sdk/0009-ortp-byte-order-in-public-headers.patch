+/* The public headers lay out the RTP and RTCP bit fields by byte order.
+ * ORTP_BIGENDIAN comes from the private ortp-config.h, which code using oRTP
+ * does not include, so take the byte order from the compiler as well. */
+#if !defined(ORTP_BIGENDIAN) && defined(__BYTE_ORDER__) && defined(__ORDER_BIG_ENDIAN__) &&                         \
+    __BYTE_ORDER__ == __ORDER_BIG_ENDIAN__
+#define ORTP_BIGENDIAN
+#endif
