+#if defined(USE_GETADDRINFO_FALLBACK)
+/* Whether conf names a DNS server: dns.c puts 0.0.0.0, meaning this host, in place of a missing one, for
+ * example when resolv.conf has no nameserver line. */
+static int _resolver_has_nameserver(const struct dns_resolv_conf *conf) {
+	const struct sockaddr *ns;
+	if (conf == NULL) return FALSE;
+	ns = (const struct sockaddr *)&conf->nameserver[0];
+	if (ns->sa_family == AF_INET) return ((const struct sockaddr_in *)ns)->sin_addr.s_addr != htonl(INADDR_ANY);
+	if (ns->sa_family == AF_INET6) return !IN6_IS_ADDR_UNSPECIFIED(&((const struct sockaddr_in6 *)ns)->sin6_addr);
+	return FALSE;
+}
+#endif
+
