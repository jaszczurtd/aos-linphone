+/* Incoming samples are in host byte order, except L16 (s->swap), which is in
+ * network order. A WAV file holds little-endian samples, a raw file the host
+ * order, so a big-endian host swaps PCM for WAV files and leaves L16 as it is. */
+static bool_t rec_swap_needed(const RecState *s) {
+#ifdef WORDS_BIGENDIAN
+	return !s->swap && s->is_wav;
+#else
+	return s->swap;
+#endif
+}
