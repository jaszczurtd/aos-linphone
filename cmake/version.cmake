# The version of the programs and the archives, in the version.revision form
# of AmigaOS version strings, and the date of the release (dd.mm.yyyy). The
# release tag is v<AOS_VERSION>, e.g. v0.1; scripts/package.sh refuses a tag
# that does not match. A release changes both lines in the commit it tags.
set(AOS_VERSION 0.1)
set(AOS_VERSION_DATE 25.11.2026)
