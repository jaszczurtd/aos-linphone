# Workbench icon of aos-phone, for the AROS host tool ilbmtoicon:
#   ilbmtoicon aos-phone.info.src aos-phone.png aos-phone.info
# Tool types in parentheses are off; remove the parentheses to use one.
TYPE = TOOL
STACK = 262144
TOOLTYPE = (DEBUG)
TOOLTYPE = (PORT=5060)
TOOLTYPE = (DATA=PROGDIR:aos-phone-data)
TOOLTYPE = (RECORD=PROGDIR:recordings)
TOOLTYPE = (CAMERA=Mire)
TOOLTYPE = (VERBOSE)
TOOLTYPE = (TESTVIDEO=PROGDIR:clip.rgb)
TOOLTYPE = (TESTVIDEOSIZE=320x240)
TOOLTYPE = (TESTVIDEOFPS=15)
TOOLTYPE = (TESTSOUND=PROGDIR:voice.raw)
TOOLTYPE = (TESTSOUNDRATE=16000)
TOOLTYPE = (MICUNIT=0)
TOOLTYPE = (STUN=stun.linphone.org)
